# CopyDocs - Environment Variables
# Copy this file to .env and fill in the values for your environment

# ── Database (SQLite) ──────────────────────────────────────────────
# Relative path works on any OS (resolved against the project root at runtime).
DATABASE_URL=file:./db/custom.db

# ── AI Assistant (Google Gemini — free tier) ───────────────────────
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# ── Security ────────────────────────────────────────────────────────
# Secret required in the `x-admin-export` header for admin export endpoints
# CHANGE THIS in production to a strong, random value
ADMIN_SECRET=copyexpress-admin-export

# ── Fonts (PDF Generation) ─────────────────────────────────────────
# Paths to DejaVu Serif TTF files used by pdf-lib.
# Docker images include these at the default Debian/Alpine locations.
FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf
FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf

# ── Payment Gateways (optional — uncomment and configure in production) ──
# EPAYCO_API_KEY=
# EPAYCO_PRIVATE_KEY=
# EPAYCO_TEST=true

# PAYU_API_KEY=
# PAYU_MERCHANT_ID=
# PAYU_ACCOUNT_ID=
# PAYU_TEST=true

# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# WOMPI_TEST=true

# ── Electronic Invoicing (optional) ─────────────────────────────────
# DIAN_API_KEY=
# DIAN_TEST_SET_ID=
