# Base de datos SQLite (por defecto usa archivo local)
DATABASE_URL=file:./db/custom.db

# Para producción en xcloud.host con persistencia, usar ruta absoluta:
# DATABASE_URL=file:/var/data/lexdoc/custom.db

# Opcional: Pasarelas de pago (descomentar y configurar en producción)
# EPAYCO_API_KEY=your_epayco_api_key
# EPAYCO_PRIVATE_KEY=your_epayco_private_key
# EPAYCO_TEST=true

# PAYU_API_KEY=your_payu_api_key
# PAYU_MERCHANT_ID=your_merchant_id
# PAYU_ACCOUNT_ID=your_account_id
# PAYU_TEST=true

# WOMPI_PUBLIC_KEY=your_wompi_public_key
# WOMPI_PRIVATE_KEY=your_wompi_private_key
# WOMPI_TEST=true

# Opcional: Facturación electrónica DIAN
# DIAN_API_KEY=your_dian_api_key
# DIAN_TEST_SET_ID=your_test_set_id
