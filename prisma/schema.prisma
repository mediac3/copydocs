generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  name          String
  email         String?
  phone         String?
  role          String    @default("client")
  status        String    @default("active")
  credits       Int       @default(10)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  documents     UserDocument[]
  contacts      Contact[]
  creditTransactions CreditTransaction[]
  creditGrants     CreditTransaction[] @relation("CreditAdmin")
}

model DocumentTemplate {
  id              String    @id @default(cuid())
  name            String
  description     String
  category        String
  subcategory     String?
  legalArea       String
  audience        String    @default("particulares")
  status          String    @default("published")
  price           Float     @default(0)
  estimatedQuestions Int     @default(10)
  estimatedMinutes   Int     @default(5)
  rating          Float     @default(0)
  ratingCount     Int       @default(0)
  thumbnail       String?
  baseContent     String
  wizardConfig    String
  clauses         TemplateClause[]
  normativity     TemplateNormativity[]
  documents       UserDocument[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Clause {
  id          String    @id @default(cuid())
  title       String
  content     String
  legalArea   String?
  category    String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  templates   TemplateClause[]
}

model TemplateClause {
  id              String @id @default(cuid())
  templateId      String
  clauseId        String
  sectionName     String?
  order           Int    @default(0)
  template        DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  clause          Clause           @relation(fields: [clauseId], references: [id], onDelete: Cascade)
}

model TemplateNormativity {
  id              String @id @default(cuid())
  templateId      String
  lawName         String
  lawReference    String
  articleNumber   String?
  description     String?
  template        DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model UserDocument {
  id              String    @id @default(cuid())
  userId          String?
  templateId      String
  title           String
  status          String    @default("draft")
  answers         String
  generatedContent String?
  visitorPhone    String?
  visitorName     String?
  template        DocumentTemplate @relation(fields: [templateId], references: [id])
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Contact {
  id              String    @id @default(cuid())
  userId          String
  name            String
  contactType     String
  documentType    String?
  documentNumber  String?
  address         String?
  city            String?
  phone           String?
  email           String?
  companyName     String?
  notes           String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DocumentRequest {
  id              String    @id @default(cuid())
  userId          String?
  title           String
  description     String
  status          String    @default("pending")
  adminNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  amount          Float
  currency        String    @default("COP")
  paymentMethod   String?
  paymentGateway  String?
  transactionRef  String?
  status          String    @default("pending")
  planName        String?
  documentId      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CreditTransaction {
  id              String    @id @default(cuid())
  userId          String
  amount          Int
  type            String
  description     String?
  adminId         String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin           User?     @relation("CreditAdmin", fields: [adminId], references: [id], onDelete: SetNull)
}
